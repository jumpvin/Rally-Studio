{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "framework-lock-schema.json",
  "title": "Product framework.lock semantic schema",
  "type": "object",
  "required": ["name", "adopted-version", "package-build", "source-package", "source-package-sha256"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "adopted-version": {"type": "string", "minLength": 1},
    "package-build": {"type": "string", "minLength": 1},
    "source-package": {"type": "string", "minLength": 1},
    "source-package-sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
